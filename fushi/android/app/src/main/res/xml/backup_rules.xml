<?xml version="1.0" encoding="utf-8"?>
<!--
  Android auto-backup rules (API <= 30; API 31+ uses data_extraction_rules.xml,
  keep both in step). The manifest also sets android:allowBackup="false".

  Kitapsen: nothing leaves the device through system backup. Store books are
  licensed to this app only (their unzipped content lives in app_flutter/), and
  the database holds the store account credentials. The library and reading
  progress come back from kitapsen.com after signing in on a new device.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
