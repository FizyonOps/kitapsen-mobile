<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup / device-transfer rules; API <= 30 uses
  backup_rules.xml, keep both in step.

  Kitapsen: neither cloud backup nor device-to-device transfer carries any app
  data. Store books are licensed to this app only and the database holds the
  store account credentials; the library and reading progress come back from
  kitapsen.com after signing in on the new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
