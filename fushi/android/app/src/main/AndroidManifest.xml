<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="app.fushi.reader">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Kitapsen: permissions of features this edition does not ship (all-files
         access, package installs, overlays, screen capture, microphone, NFC
         pairing, every foreground service: audio playback, special-use overlays,
         data sync, media projection) are not declared; the tools:node="remove"
         entries strip the ones plugin manifests would merge back in. The
         audio_service player is not declared either (AudioController uses the
         in-process handler in the Kitapsen edition). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" tools:node="remove"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
    <application
        android:label="Kitapsen"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon_squircle"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        xmlns:tools="http://schemas.android.com/tools"
        tools:replace="android:label">
        <activity
            android:name=".mihon.CloudflareChallengeActivity"
            android:exported="false"
            android:process=":network_challenge"
            android:excludeFromRecents="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                    the Android process has started. This theme is visible to the user
                    while the Flutter UI initializes. After that, this theme continues
                    to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"
                />
            <!-- ReceiveIntent owns URL dispatch; do not also create a Flutter route. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false" />
            <!-- Kitapsen registers no external URL scheme: fushi://auth|source|pair
                 belonged to cloud OAuth, Anki source links and device pairing, none
                 of which ship. App shortcuts still use fushi://shortcut/<id>, but as
                 an explicit intent (AppShortcutsHelper), so no filter is needed. -->
        </activity>

        <!-- Launcher icon aliases for runtime icon switching -->
        <activity-alias
            android:name=".MainActivityDefault"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/launcher_icon_squircle"
            android:label="Kitapsen"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
        </activity-alias>




        <!-- Kitapsen: the popup / floating dictionary activities and services
             (PopupDictActivity, PopupDictFlutterActivity, floating dict / lyric /
             ball, screen OCR, accessibility capture, quick-settings tile) are not
             declared: no dictionary ships, and nothing may register system-wide
             text-selection, share or translate entries. Their Java classes stay
             compiled but are unreachable. -->
        <provider
            android:name="app.fushi.reader.FushiFileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
        <provider
            android:name="com.pichillilorenzo.flutter_inappwebview_android.InAppWebViewFileProvider"
            android:authorities="${applicationId}.flutter_inappwebview.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>
        <!-- TODO-1110 / BUG-535：禁用 Flutter 的 Android SurfaceControl 后端。
             media_kit_video 1.3.0 起把 Android 纹理从 SurfaceTextureEntry 迁到
             TextureRegistry.SurfaceProducer。在部分 Android 11 ROM/GPU 驱动
             （如 RMX3085/realme 8）上，SurfaceControl 支撑的 SurfaceProducer 首次
             onSurfaceAvailable 回调不触发 → native wid 永为 0 → android_video_controller
             widListener 永远设 vo=null → mpv 拿不到 GL surface（current-vo/gpu-api 全空、
             texture id 停 null）→ 解码出帧但无画面（黑屏）。参见 flutter/flutter#156488、
             #162902（SurfaceProducer 表面生命周期），媒体渲染最广兼容路径是关掉
             SurfaceControl，让 SurfaceProducer 回落到经典 ImageReader/SurfaceTexture 支撑
             （表面同步可用）。这是 Flutter 官方文档化的后端选择开关，非绕过/掩盖补丁；
             对已正常出画的设备无功能差异（只是不用较新的 SurfaceControl 合成路径）。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableSurfaceControl"
            android:value="false" />
        <!-- Don't delete the meta-data below.
                This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <!-- 选区「网页搜索」要先解析出默认浏览器再定向 ACTION_WEB_SEARCH（BUG-2491）。
             Android 11+ 包可见性：不声明这条 VIEW https，resolveActivity 看不到任何浏览器，
             只能退回裸 intent、落到自带浏览器。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
